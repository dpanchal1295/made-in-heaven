# Gemini API Configuration (Server-Side Only - NEVER expose to client)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
MAYA_MOCK=true # Set to true to use realistic mock data without calling Gemini

# Application Session Security (Required: HMAC secret for signing session cookies)
SESSION_SECRET=your_random_32_byte_hex_session_secret_here

# Storage Driver Selection ('local' for development / disk cache, 'firestore' for production Firebase)
STORAGE_DRIVER=local

# Firebase Client Configuration (Safe for browser client)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Firebase Admin Service Account Credentials (Server-Side Only - Firestore production driver)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional alternate service account single-string base64 representation
# FIREBASE_SERVICE_ACCOUNT_BASE64=your_base64_encoded_service_account_json
